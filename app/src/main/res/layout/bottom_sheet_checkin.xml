<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_secondary"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/text_hint"
        android:layout_marginBottom="20dp" />

    <!-- Habit icon + name -->
    <TextView
        android:id="@+id/checkin_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="48sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/checkin_habit_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Today's target -->
    <TextView
        android:id="@+id/checkin_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/checkin_difficulty_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_primary_light"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <!-- How did it go? -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/how_did_it_go"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <!-- Effort tags -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/effort_hard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="@string/effort_hard"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_effort_tag"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/effort_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="@string/effort_ok"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_effort_tag"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/effort_easy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/effort_easy"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_effort_tag"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Action buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_complete"
        style="@style/Widget.HabitTracker.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/mark_complete"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip"
        style="@style/Widget.HabitTracker.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/skip_today" />

    <!-- Feedback after completion (hidden initially) -->
    <LinearLayout
        android:id="@+id/feedback_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/feedback_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
